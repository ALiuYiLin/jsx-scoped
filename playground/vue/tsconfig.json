{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": ["vite/client", "@10coding/vite-plugin-jsx-scoped/client"],
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "vite.config.ts"]
}
