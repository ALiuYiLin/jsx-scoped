{
  "name": "jsx-scoped",
  "version": "0.1.0",
  "private": true,
  "description": "Vue-like scoped styles for JSX/TSX (React) — monorepo for babel / postcss / vite plugins",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:babel": "pnpm --filter @10coding/plugin-jsx-scoped build",
    "test:babel": "pnpm --filter @10coding/plugin-jsx-scoped test"
  }
}
