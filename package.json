{
  "name": "jsx-scoped",
  "version": "0.1.0",
  "private": true,
  "description": "Vue-like scoped styles for JSX/TSX (React) — monorepo for babel / postcss / vite plugins",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:demo": "pnpm --filter @10coding/example-react build",
    "build:demo:solid": "pnpm --filter @10coding/example-solid build",
    "demo": "pnpm --filter @10coding/example-react dev",
    "demo:solid": "pnpm --filter @10coding/example-solid dev",
    "test": "pnpm --filter @10coding/plugin-jsx-scoped test && pnpm --filter @10coding/postcss-jsx-scoped test",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset version && changeset publish",
    "publish:packages": "pnpm -r publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1"
  }
}
